# Never commit real secrets. Set these in the Vast template environment.
HF_TOKEN=
APP_USER=arye
APP_PASSWORD=
STACK_ROOT=/workspace/ai-stack
# Optional persistent mount. When set, model weights and download caches live
# here and can be reused by future instances.
PERSIST_ROOT=
SETUP_MODE=validate
INSTALL_LTX=1
INSTALL_MUSETALK=1
INSTALL_CHATTERBOX=1
INSTALL_OPENMONTAGE=0
AUTO_LAUNCH=1
GRADIO_PORT=7860
AUTO_STOP_MINUTES=0
# Irreversible safety option. If nonzero, it takes precedence over AUTO_STOP_MINUTES.
AUTO_DESTROY_MINUTES=0
# Vast injects both values automatically. Never replace CONTAINER_API_KEY with
# a full account key; the per-instance key is intentionally restricted.
# CONTAINER_ID=
# CONTAINER_API_KEY=
